# User/Group IDs (match your system user)
PUID=1000
PGID=1000
UMASK=002

# Timezone
TZ=America/New_York

# Hostname
HOSTNAME=media.example.com

# Paths (update to your media storage paths)
CONFIG_BASE_PATH=/path/to/config
DATA_PATH=/path/to/data

# Vault
VAULT_ADDR=https://vault.example.com

# Downloads path for torrents
DOWNLOADS_PATH=/path/to/downloads
